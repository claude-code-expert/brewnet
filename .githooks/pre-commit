#!/bin/sh
# Auto-unstage specified directories before every commit
git diff --cached --name-only | grep -E '^(docs/phase|docs/spec|docs/license|public/demo)/' | while read file; do
  git restore --staged "$file"
done

# Run tests before commit — only when source/test files are staged
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
HAS_SRC=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' | head -1)

if [ -n "$HAS_SRC" ]; then
  echo "🧪 Running tests before commit..."
  pnpm test 2>&1
  TEST_EXIT=$?
  if [ $TEST_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Tests failed — commit aborted. Fix the failures and try again."
    exit 1
  fi
  echo "✅ All tests passed."
fi

# Install integrity checks — when install-related files are staged
INSTALL_PATTERN="install\.sh|packages/cli/tsup\.config|packages/cli/package\.json|packages/cli/src/index\.ts|packages/cli/src/services/admin-server\.ts|\.github/workflows/publish\.yml"
HAS_INSTALL=$(echo "$STAGED" | grep -E "$INSTALL_PATTERN" | head -1)

if [ -n "$HAS_INSTALL" ]; then
  echo "🔧 Install-related files changed — running install integrity tests..."

  if [ -f "tests/install/install-sh.test.sh" ]; then
    bash tests/install/install-sh.test.sh
    if [ $? -ne 0 ]; then
      echo "❌ install.sh integrity test failed — commit aborted."
      exit 1
    fi
  fi

  if [ -f "tests/install/cli-dist.test.sh" ] && [ -f "packages/cli/dist/index.js" ]; then
    bash tests/install/cli-dist.test.sh
    if [ $? -ne 0 ]; then
      echo "❌ CLI dist integrity test failed — commit aborted."
      exit 1
    fi
  fi

  echo "✅ Install integrity checks passed."
fi

exit 0
